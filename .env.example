NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# LLM: set ONE. Claude wins if ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
TRIBUNAL_CLAUDE_MODEL=claude-opus-5
# medium keeps a hearing watchable on stage; high = deeper, slower
TRIBUNAL_CLAUDE_EFFORT=medium
OPENAI_API_KEY=
GROQ_API_KEY=
TRIBUNAL_CHAT_MODEL=gpt-4o-mini
TRIBUNAL_EMBED_MODEL=text-embedding-3-small

# Confluent Cloud (leave blank to run without streaming; see confluent/README.md)
CONFLUENT_BOOTSTRAP=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
SR_URL=
SR_API_KEY=
SR_API_SECRET=
# flink = the veto window is decided by confluent/flink/02_veto_window.sql
# client = browser timer decides, Flink only observes
TRIBUNAL_EXECUTOR=flink
